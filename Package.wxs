<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="StegSolve-RS" Manufacturer="DawnMagnet" Version="0.1.0"
        UpgradeCode="12345678-1234-1234-1234-123456789012">
        <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />

        <Media Id="1" Cabinet="stegsolve.cab" EmbedCab="yes" />

        <Feature Id="MainFeature" Title="StegSolve-RS" Level="1">
            <ComponentGroupRef Id="ProductComponents" />
        </Feature>

        <StandardDirectory Id="ProgramFiles6432Folder">
            <Directory Id="INSTALLFOLDER" Name="StegSolve-RS" />
        </StandardDirectory>
    </Package>

    <Fragment>
        <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
            <Component Id="MainExecutable">
                <File Id="StegSolveExe" Source="target\release\stegsolve-rs.exe" KeyPath="yes">
                    <Shortcut Id="StartMenuShortcut"
                        Directory="ProgramMenuFolder"
                        Name="StegSolve-RS"
                        Description="Steganography Analysis Tool"
                        WorkingDirectory="INSTALLFOLDER"
                        Icon="StegSolveIcon"
                        IconIndex="0" />
                </File>
            </Component>
            <Component Id="IconFile">
                <File Id="IconIco" Source="icon.ico" />
            </Component>
        </ComponentGroup>
    </Fragment>

    <Fragment>
        <Icon Id="StegSolveIcon" SourceFile="icon.ico" />
    </Fragment>
</Wix>