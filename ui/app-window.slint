import {
    Button,
    VerticalBox,
    HorizontalBox,
    CheckBox,
    Slider,
    TextEdit,
    ComboBox,
} from "std-widgets.slint";

export component DataExtractDialog inherits Window {
    title: "Data Extract";
    min-width: 624px;
    min-height: 468px;

    in-out property <bool> lsb-first: true;
    in-out property <bool> row-order: true;
    in-out property <int> color-order: 0;
    in property <string> preview-text: "";

    callback update-mask(int, bool);
    callback request-preview();
    callback close-dialog();
    callback update-overlay(bool);
    callback copy-hex-view();
    callback copy-hex-raw();
    callback copy-bin();

    VerticalBox {
        padding: 10px;
        spacing: 8px;

        Text {
            text: "Bit Mask (R/G/B/A 0-7)";
            font-size: 14px;
            font-weight: 700;
        }

        // Red bits
        HorizontalBox {
            spacing: 6px;
            Text {
                text: "R";
                width: 16px;
                vertical-alignment: center;
            }

            CheckBox {
                text: "0";
                toggled => {
                    root.update-mask(0, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "1";
                toggled => {
                    root.update-mask(1, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "2";
                toggled => {
                    root.update-mask(2, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "3";
                toggled => {
                    root.update-mask(3, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "4";
                toggled => {
                    root.update-mask(4, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "5";
                toggled => {
                    root.update-mask(5, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "6";
                toggled => {
                    root.update-mask(6, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "7";
                toggled => {
                    root.update-mask(7, self.checked);
                    root.request-preview();
                }
            }
        }

        // Green bits
        HorizontalBox {
            spacing: 6px;
            Text {
                text: "G";
                width: 16px;
                vertical-alignment: center;
            }

            CheckBox {
                text: "0";
                toggled => {
                    root.update-mask(8, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "1";
                toggled => {
                    root.update-mask(9, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "2";
                toggled => {
                    root.update-mask(10, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "3";
                toggled => {
                    root.update-mask(11, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "4";
                toggled => {
                    root.update-mask(12, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "5";
                toggled => {
                    root.update-mask(13, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "6";
                toggled => {
                    root.update-mask(14, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "7";
                toggled => {
                    root.update-mask(15, self.checked);
                    root.request-preview();
                }
            }
        }

        // Blue bits
        HorizontalBox {
            spacing: 6px;
            Text {
                text: "B";
                width: 16px;
                vertical-alignment: center;
            }

            CheckBox {
                text: "0";
                toggled => {
                    root.update-mask(16, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "1";
                toggled => {
                    root.update-mask(17, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "2";
                toggled => {
                    root.update-mask(18, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "3";
                toggled => {
                    root.update-mask(19, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "4";
                toggled => {
                    root.update-mask(20, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "5";
                toggled => {
                    root.update-mask(21, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "6";
                toggled => {
                    root.update-mask(22, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "7";
                toggled => {
                    root.update-mask(23, self.checked);
                    root.request-preview();
                }
            }
        }

        // Alpha bits
        HorizontalBox {
            spacing: 6px;
            Text {
                text: "A";
                width: 16px;
                vertical-alignment: center;
            }

            CheckBox {
                text: "0";
                toggled => {
                    root.update-mask(24, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "1";
                toggled => {
                    root.update-mask(25, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "2";
                toggled => {
                    root.update-mask(26, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "3";
                toggled => {
                    root.update-mask(27, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "4";
                toggled => {
                    root.update-mask(28, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "5";
                toggled => {
                    root.update-mask(29, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "6";
                toggled => {
                    root.update-mask(30, self.checked);
                    root.request-preview();
                }
            }

            CheckBox {
                text: "7";
                toggled => {
                    root.update-mask(31, self.checked);
                    root.request-preview();
                }
            }
        }

        HorizontalBox {
            spacing: 12px;
            CheckBox {
                text: "LSB first";
                checked <=> root.lsb-first;
                toggled => {
                    root.request-preview();
                }
            }

            CheckBox {
                text: "Row order";
                checked <=> root.row-order;
                toggled => {
                    root.request-preview();
                }
            }

            CheckBox {
                text: "Mask Overlay";
                toggled => {
                    root.update-overlay(self.checked);
                }
            }

            Text {
                text: "Channel order";
                vertical-alignment: center;
            }

            ComboBox {
                model: ["RGB", "RBG", "GRB", "GBR", "BRG", "BGR"];
                current-index <=> root.color-order;
                selected(_) => {
                    root.request-preview();
                }
            }
        }

        Text {
            text: "Preview";
            font-size: 13px;
            font-weight: 700;
        }

        TextEdit {
            text: root.preview-text;
            read-only: true;
            font-family: "Consolas";
            min-height: 32px;
            vertical-stretch: 1;
        }

        HorizontalBox {
            alignment: end;
            spacing: 8px;
            Button {
                text: "Copy Hex";
                clicked => {
                    root.copy-hex-view();
                }
            }

            Button {
                text: "Copy Bin";
                clicked => {
                    root.copy-bin();
                }
            }

            Button {
                text: "Copy HEX";
                clicked => {
                    root.copy-hex-raw();
                }
            }

            Button {
                text: "Close";
                clicked => {
                    root.close-dialog();
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Rust StegSolve";
    icon: @image-url("icon.png");
    min-width: 800px;
    min-height: 600px;

    // 回调函数定义
    callback open-file();
    callback export-frame();
    callback copy-hex();
    callback open-data-extract();
    callback next-filter();
    callback prev-filter();
    callback next-frame();
    callback prev-frame();
    callback toggle-play();
    callback stereo-enabled-changed(bool);
    callback stereo-offset-changed(float);

    // 属性定义
    in property <image> displayed-image;
    in property <string> filter-name: "Normal";
    in property <string> image-info: "No image loaded";
    in property <string> frame-info: "Frame 1/1";
    in-out property <bool> stereo-enabled: false;
    in-out property <float> stereo-offset: 0;
    in property <bool> is-playing: false;

    VerticalBox {
        padding: 5px;
        spacing: 5px;

        // 顶部工具栏
        HorizontalBox {
            padding: 0;
            spacing: 10px;
            alignment: start;
            Button {
                text: "Open File";
                height: 30px;
                clicked => {
                    root.open-file();
                }
            }

            Button {
                text: "Export PNG";
                height: 30px;
                clicked => {
                    root.export-frame();
                }
            }

            Button {
                text: "Copy Hex";
                height: 30px;
                clicked => {
                    root.copy-hex();
                }
            }

            Button {
                text: "Data Extract";
                height: 30px;
                clicked => {
                    root.open-data-extract();
                }
            }
            // 显示图片名称或缩放信息
            Text {
                text: root.image-info;
                vertical-alignment: center;
                font-size: 12px;
                color: gray;
            }
        }

        // 图片显示区域
        Rectangle {
            background: #202020;
            border-width: 1px;
            border-color: #444;
            clip: true;
            vertical-stretch: 1; // 占据所有可用空间

            Image {
                source: root.displayed-image;
                image-fit: contain;
                image-rendering: pixelated;
                width: 100%;
                height: 100%;
            }
        }

        // 底部控制栏
        HorizontalBox {
            padding: 5px;
            alignment: center;
            spacing: 20px;
            height: 40px;

            Button {
                text: "< Prev";
                width: 80px;
                height: 30px;
                clicked => {
                    root.prev-filter();
                }
            }

            Rectangle {
                background: #333;
                border-radius: 4px;
                width: 200px;
                height: 30px;
                Text {
                    text: root.filter-name;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    font-size: 14px;
                    font-weight: 700;
                    color: white;
                }
            }

            Button {
                text: "Next >";
                width: 80px;
                height: 30px;
                clicked => {
                    root.next-filter();
                }
            }
        }

        // 帧与立体图控制栏
        HorizontalBox {
            padding: 5px;
            alignment: center;
            spacing: 12px;
            height: 40px;

            Button {
                text: "Prev Frame";
                clicked => {
                    root.prev-frame();
                }
            }

            Text {
                text: root.frame-info;
                vertical-alignment: center;
            }

            Button {
                text: "Next Frame";
                clicked => {
                    root.next-frame();
                }
            }

            Button {
                text: root.is-playing ? "Pause" : "Play";
                clicked => {
                    root.toggle-play();
                }
            }

            CheckBox {
                text: "Stereo";
                checked <=> root.stereo-enabled;
                toggled => {
                    root.stereo-enabled-changed(self.checked);
                }
            }

            Slider {
                minimum: -200;
                maximum: 200;
                value <=> root.stereo-offset;
                enabled: root.stereo-enabled;
                width: 160px;
                changed => {
                    root.stereo-offset-changed(self.value);
                }
            }

            Text {
                text: root.stereo-offset;
                vertical-alignment: center;
            }
        }
    }
}
