import {
    Button,
    VerticalBox,
    HorizontalBox,
    CheckBox,
    Slider,
    TextEdit,
    ComboBox,
    Palette,
} from "std-widgets.slint";
import { DataExtractDialog } from "data-extract.slint";

export { DataExtractDialog }
export { Palette }

export component AppWindow inherits Window {
    title: "Rust StegSolve";
    icon: @image-url("icon.png");
    min-width: 800px;
    min-height: 600px;

    // 回调函数定义
    callback open-file();
    callback export-frame();
    callback copy-hex();
    callback open-data-extract();
    callback next-filter();
    callback prev-filter();
    callback next-frame();
    callback prev-frame();
    callback toggle-play();
    callback stereo-enabled-changed(bool);
    callback stereo-offset-changed(float);
    callback toggle-theme();

    // 属性定义
    in property <image> displayed-image;
    in property <string> filter-name: "Normal";
    in property <string> image-info: "No image loaded";
    in property <string> frame-info: "Frame 1/1";
    in-out property <bool> stereo-enabled: false;
    in-out property <float> stereo-offset: 0;
    in property <bool> is-playing: false;
    in-out property <int> theme-index: 0;

    VerticalBox {
        padding: 5px;
        spacing: 5px;

        // 顶部工具栏
        HorizontalBox {
            padding: 0;
            spacing: 10px;
            // alignment: start; // Check removed to fix spacer stretching
            Button {
                text: "Open File";
                height: 30px;
                clicked => {
                    root.open-file();
                }
            }

            Button {
                text: "Export PNG";
                height: 30px;
                clicked => {
                    root.export-frame();
                }
            }

            Button {
                text: "Copy Hex";
                height: 30px;
                clicked => {
                    root.copy-hex();
                }
            }

            Button {
                text: "Data Extract";
                height: 30px;
                clicked => {
                    root.open-data-extract();
                }
            }
            // 显示图片名称或缩放信息
            Text {
                text: root.image-info;
                vertical-alignment: center;
                font-size: 12px;
                color: gray;
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }

            // Theme toggle button (right aligned)
            Button {
                width: 36px;
                height: 30px;
                clicked => {
                    root.toggle-theme();
                }
                icon: root.theme-index == 0 ? @image-url("../assets/icons/theme-system.svg") : root.theme-index == 1 ? @image-url("../assets/icons/theme-light.svg") : @image-url("../assets/icons/theme-dark.svg");
                colorize-icon: true;
            }
        }

        // 图片显示区域
        Rectangle {
            background: Palette.control-background;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;
            vertical-stretch: 1; // 占据所有可用空间

            Image {
                source: root.displayed-image;
                image-fit: contain;
                image-rendering: pixelated;
                width: 100%;
                height: 100%;
            }
        }

        // 底部控制栏
        HorizontalBox {
            padding: 5px;
            alignment: center;
            spacing: 20px;
            height: 40px;

            Button {
                text: "< Prev";
                width: 80px;
                height: 30px;
                clicked => {
                    root.prev-filter();
                }
            }

            Rectangle {
                background: #333;
                border-radius: 4px;
                width: 200px;
                height: 30px;
                Text {
                    text: root.filter-name;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    font-size: 14px;
                    font-weight: 700;
                    color: white;
                }
            }

            Button {
                text: "Next >";
                width: 80px;
                height: 30px;
                clicked => {
                    root.next-filter();
                }
            }
        }

        // 帧与立体图控制栏
        HorizontalBox {
            padding: 5px;
            alignment: center;
            spacing: 12px;
            height: 40px;

            Button {
                text: "Prev Frame";
                clicked => {
                    root.prev-frame();
                }
            }

            Text {
                text: root.frame-info;
                vertical-alignment: center;
            }

            Button {
                text: "Next Frame";
                clicked => {
                    root.next-frame();
                }
            }

            Button {
                text: root.is-playing ? "Pause" : "Play";
                clicked => {
                    root.toggle-play();
                }
            }

            CheckBox {
                text: "Stereo";
                checked <=> root.stereo-enabled;
                toggled => {
                    root.stereo-enabled-changed(self.checked);
                }
            }

            Slider {
                minimum: -200;
                maximum: 200;
                value <=> root.stereo-offset;
                enabled: root.stereo-enabled;
                width: 160px;
                changed => {
                    root.stereo-offset-changed(self.value);
                }
            }

            Text {
                text: root.stereo-offset;
                vertical-alignment: center;
            }
        }
    }
}
